BasedOnStyle: LLVM
AccessModifierOffset: -4
UseTab: Never
IndentWidth: 4
TabWidth: 4
BreakBeforeBraces: Custom
BraceWrapping:
  AfterNamespace: false
  AfterClass: false
  AfterStruct: false
WrapNamespaceBodyWithEmptyLines: Always
AllowShortIfStatementsOnASingleLine: Never
IndentCaseLabels: false
ColumnLimit: 120
NamespaceIndentation: All
FixNamespaceComments: true
InsertNewlineAtEOF: true
# Main header, then "lox/..." headers, then third-party <lib/...>, then the standard library.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"lox/'
    Priority: 1
  - Regex: '^<[[:alnum:]_.]+/'
    Priority: 2
  - Regex: '^<'
    Priority: 3
